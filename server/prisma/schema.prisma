generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  username             String?              @unique
  googleId             String?              @unique
  /// Mật khẩu đã được hash (bcrypt)
  passwordHash         String?
  name                 String
  avatarUrl            String?
  phone                String?
  role                 UserRole             @default(USER)
  accountStatus        AccountStatus        @default(ACTIVE)
  /// Xác thực email
  isVerified           Boolean              @default(false)
  /// Số lần nhập sai OTP liên tiếp
  failedOtpAttempts    Int                  @default(0) @map("failed_otp_attempts")
  /// Thời điểm hết hạn khóa do nhập sai OTP
  lockedUntil          DateTime?            @map("locked_until")
  /// Refresh token lưu trong DB (backup cho Redis)
  refreshToken         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  managedSpaAddresses  AddressSpa[]         @relation("SpaAddressManager")
  addresses            Address[]
  auditLogs            AuditLog[]           @relation("AuditActor")
  cartItems            CartItem[]
  sentLikes            Like[]               @relation("LikeSender")
  matchingRequests     MatchingRequest[]    @relation("MatchingRequester")
  messages             Message[]
  orders               Order[]
  reviewedDocuments    PetDocument[]        @relation("PetDocumentReviewer")
  pets                 Pet[]
  reviews              ProductReview[]
  assignedSpaBookings  SpaBooking[]         @relation("SpaStaffBookings")
  spaBookings          SpaBooking[]
  spaFeedbacks         SpaFeedback[]
  managedSpaCategories SpaCategory[]        @relation("SpaCategoryManager")
  spaStaffProfile      SpaStaff?            @relation("UserSpaStaffProfile")
  managedStores        Store[]              @relation("StoreManager")
  wishlistItems        WishlistItem[]
  passwordResetTokens  PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("password_reset_tokens")
}

model Breed {
  id        String   @id @default(cuid())
  species   Species
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([species, name])
  @@map("breeds")
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([email])
  @@map("email_otps")
}

model Pet {
  id                       String            @id @default(cuid())
  name                     String
  slug                     String?           @unique
  species                  Species
  breed                    String
  gender                   Gender
  /// Ngày sinh - dùng để tính tuổi và kiểm tra điều kiện phối giống
  birthday                 DateTime
  weight                   Float
  colorDesc                String?
  /// Chủ tự khai báo đã tiêm vaccine (chưa có bằng chứng)
  isVaccinated             Boolean           @default(false)
  /// Chủ tự khai báo có giấy phả hệ (chưa có bằng chứng)
  hasPedigree              Boolean           @default(false)
  pedigreeNumber           String?
  /// Đã xác minh vaccine qua giấy tờ thực tế
  vaccineVerified          Boolean           @default(false)
  /// Đã xác minh giấy phả hệ qua giấy tờ thực tế
  pedigreeVerified         Boolean           @default(false)
  /// Badge tổng hợp hiển thị trên card - được cập nhật bởi DocumentService:
  /// - NONE     → chưa upload giấy tờ nào
  /// - PENDING  → có giấy tờ đang chờ duyệt
  /// - VERIFIED → ít nhất một giấy tờ được duyệt
  verificationBadge        VerificationBadge @default(NONE)
  avatarUrl                String?
  /// Mảng URL ảnh (Cloudinary), tối đa 6 ảnh
  gallery                  String[]
  personality              String?
  breedingOption           BreedingOption    @default(NEGOTIATE)
  /// Giá phối giống (VNĐ) - chỉ có khi breedingOption = CASH
  breedingFee              Float?
  /// Số con chia sẻ - chỉ có khi breedingOption = SHARE_LITTER
  shareLitterCount         Int?
  /// Ngày phối giống gần nhất - dùng để tính chu kỳ
  lastBreedingAt           DateTime?
  /// Tổng số lần phối giống thành công
  totalBreedings           Int               @default(0)
  location                 String
  district                 String?
  ward                     String?
  /// Toạ độ cho Redis GEOSEARCH (tìm gần vị trí người dùng)
  latitude                 Float?
  longitude                Float?
  status                   PetStatus         @default(ACTIVE)
  isAvailableForMatching   Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  ownerId                  String
  sentLikes                Like[]            @relation("LikeFromPet")
  receivedLikes            Like[]            @relation("LikeToPet")
  matchesAsPet1            Match[]           @relation("MatchPet1")
  matchesAsPet2            Match[]           @relation("MatchPet2")
  sentMatchingRequests     MatchingRequest[] @relation("FemalePetRequests")
  receivedMatchingRequests MatchingRequest[] @relation("MalePetRequests")
  documents                PetDocument[]
  owner                    User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  spaBookings              SpaBooking[]

  @@index([species, gender, status, isAvailableForMatching])
  @@index([ownerId])
  @@index([breed])
  @@index([location])
  @@map("pets")
}

model Like {
  id         String     @id @default(cuid())
  fromUserId String
  fromPetId  String
  toPetId    String
  status     LikeStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  fromPet    Pet        @relation("LikeFromPet", fields: [fromPetId], references: [id])
  fromUser   User       @relation("LikeSender", fields: [fromUserId], references: [id])
  toPet      Pet        @relation("LikeToPet", fields: [toPetId], references: [id])

  @@unique([fromPetId, toPetId])
  @@index([fromUserId])
  @@index([toPetId, status])
  @@map("likes")
}

model MatchingRequest {
  id          String                @id @default(cuid())
  requesterId String
  femalePetId String
  malePetId   String
  status      MatchingRequestStatus @default(PENDING)
  note        String?
  respondedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  femalePet   Pet                   @relation("FemalePetRequests", fields: [femalePetId], references: [id])
  malePet     Pet                   @relation("MalePetRequests", fields: [malePetId], references: [id])
  requester   User                  @relation("MatchingRequester", fields: [requesterId], references: [id])

  @@index([requesterId, status])
  @@index([femalePetId, malePetId, status])
  @@index([malePetId, status])
  @@map("matching_requests")
}

model Match {
  id                      String      @id @default(cuid())
  pet1Id                  String
  pet2Id                  String
  /// Điểm tương thích 0-100 (tính bởi matching engine)
  compatibilityScore      Int         @default(0)
  /// Lý do match (JSON): ["same_breed", "both_pedigree", "breed_compatible", "near_location"]
  matchReasons            Json?
  status                  MatchStatus @default(ACTIVE)
  pet1MeetingConfirmedAt  DateTime?
  pet2MeetingConfirmedAt  DateTime?
  firstMeetingConfirmerId String?
  /// Ghi chú kết quả sau khi phối giống xong (COMPLETED)
  breedingNote            String?
  expectedDueDate         DateTime?
  completedAt             DateTime?
  endedAt                 DateTime?
  endedById               String?
  endReason               String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  pet1                    Pet         @relation("MatchPet1", fields: [pet1Id], references: [id])
  pet2                    Pet         @relation("MatchPet2", fields: [pet2Id], references: [id])
  messages                Message[]

  @@unique([pet1Id, pet2Id])
  @@index([pet1Id, status])
  @@index([pet2Id, status])
  @@map("matches")
}

model Message {
  id        String   @id @default(cuid())
  content   String
  imageUrl  String?
  matchId   String
  senderId  String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([matchId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model BreedRule {
  id            String   @id @default(cuid())
  species       Species
  /// Giống A
  breedA        String
  /// Giống B
  breedB        String
  /// true  = tương thích tốt (cross-breed compatible, +20 điểm)
  /// false = không khuyến nghị (genetic risk, -10 điểm)
  isCompatible  Boolean  @default(true)
  /// Tên giống con dự kiến nếu lai (vd: "Corgi Gold", "F1 Hybrid")
  offspringName String?
  /// Ghi chú cảnh báo nếu có rủi ro di truyền
  warningNote   String?
  /// Cho phép tạm ngưng quy tắc mà không cần xóa dữ liệu
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([breedA, breedB, species])
  @@index([species, isActive])
  @@map("breed_rules")
}

model PetDocument {
  id           String         @id @default(cuid())
  petId        String
  /// Loại giấy tờ
  type         DocumentType
  /// Tiêu đề / tên giấy tờ do user nhập (vd: "Sổ tiêm phòng 2024")
  title        String?
  /// Mảng URL ảnh giấy tờ (Cloudinary) - có thể upload nhiều trang
  imageUrls    String[]
  /// Mô tả thêm từ chủ pet (vd: số phiếu, ngày cấp)
  userNote     String?
  status       DocumentStatus @default(PENDING)
  /// ID của moderator/admin đã duyệt
  reviewerId   String?
  /// Tên moderator (denormalized để hiển thị nhanh)
  reviewerName String?
  /// Ghi chú của moderator (bắt buộc khi REJECTED)
  reviewNote   String?
  /// Thời điểm moderator xử lý
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  pet          Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  reviewer     User?          @relation("PetDocumentReviewer", fields: [reviewerId], references: [id])

  @@index([petId, type])
  @@index([status, type])
  @@map("pet_documents")
}

model PetReport {
  id         String   @id @default(cuid())
  petId      String
  userId     String
  reason     String
  detail     String?
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("pet_reports")
}

model Store {
  id          String         @id @default(cuid())
  name        String
  description String?
  address     String?
  phone       String?
  status      ApprovalStatus @default(PENDING)
  managerId   String?
  approvedAt  DateTime?
  suspendedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orders      Order[]
  products    Product[]
  manager     User?          @relation("StoreManager", fields: [managerId], references: [id])

  @@index([status])
  @@index([managerId])
  @@map("stores")
}

model Product {
  /// Mã sản phẩm dạng 6 chữ số, ví dụ: 482731
  id             String          @id
  name           String
  slug           String?         @unique
  category       String
  targetSpecies  String          @default("ALL")
  description    String?
  imageUrl       String?
  images         String[]
  specifications Json?
  sellingPrice   Float
  salePrice      Float?
  importPrice    Float?
  brand          String?
  unit           String?
  rating         Float           @default(0)
  reviewCount    Int             @default(0)
  stock          Int             @default(5)
  isActive       Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  storeId        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reviews        ProductReview[]
  store          Store?          @relation(fields: [storeId], references: [id])
  wishlistItems  WishlistItem[]
  variants       ProductVariant[]

  @@index([category, isActive])
  @@index([isFeatured, isActive])
  @@index([targetSpecies, isActive])
  @@index([storeId])
  @@map("products")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  receiverName  String
  receiverPhone String
  province      String
  district      String
  ward          String
  detail        String
  provinceId    Int?
  districtId    Int?
  wardCode      String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Order {
  id                  String      @id @default(cuid())
  userId              String
  status              OrderStatus @default(PENDING)
  totalAmount         Float
  shippingFee         Float       @default(0)
  discountAmount      Float       @default(0)
  voucherCode         String?
  shippingAddress     String
  districtId          Int?
  wardCode            String?
  ghnOrderCode        String?
  shippingStatus      String?
  storeId             String?
  paymentMethod       String      @default("COD")
  orderCode           Int?        @unique
  paymentUrl          String?
  refundStatus        String?
  refundBankCode      String?
  refundAccountNumber String?
  refundAccountName   String?
  refundReason        String?
  refundedAt          DateTime?
  deliveryProofUrl    String?
  shippingNote        String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]
  store               Store?      @relation(fields: [storeId], references: [id])
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storeId])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId String
  variantId String?         @map("variant_id")
  quantity  Int
  price     Float
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model SpaCategory {
  id          String         @id @default(cuid())
  name        String
  description String?
  isMain      Boolean        @default(true)
  status      ApprovalStatus @default(PENDING)
  managerId   String?
  approvedAt  DateTime?
  suspendedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  bookings    SpaBooking[]
  manager     User?          @relation("SpaCategoryManager", fields: [managerId], references: [id])
  services    SpaService[]

  @@index([status])
  @@index([managerId])
  @@map("spa_categories")
}

model SpaService {
  id           String       @id @default(cuid())
  categoryId   String       @map("category_id")
  name         String
  description  String?
  species      Species?
  petWeightMin Float?
  petWeightMax Float?
  price        Float
  durationMin  Int
  durationMax  Int?
  isMain       Boolean      @default(true)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  bookings     SpaBooking[]
  category     SpaCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, isActive])
  @@map("spa_services")
}

model SpaBooking {
  id                    String           @id @default(cuid())
  categoryId            String?          @map("category_id")
  serviceId             String?
  mainServiceId         String?
  subServiceIds         String[]         @default([])
  userId                String
  staffId               String?
  petName               String?
  petId                 String?
  petSpecies            Species?
  petWeight             Float?
  addressSpaId          String?
  scheduledAt           DateTime
  status                SpaBookingStatus @default(PENDING)
  priceSnapshot         Float?
  totalPrice            Float            @default(0)
  discountAmount        Float            @default(0)
  timeStartExpected     DateTime?
  timeEndExpected       DateTime?
  timeStartReal         DateTime?
  timeEndReal           DateTime?
  completionDiffMinutes Int?
  note                  String?
  petConditionAfter     String?
  photoAfter            String?
  issueReported         String?
  isPaid                Boolean          @default(false)
  paymentMethod         String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  addressSpa            AddressSpa?      @relation("SpaBookingAddress", fields: [addressSpaId], references: [id])
  category              SpaCategory?     @relation(fields: [categoryId], references: [id])
  pet                   Pet?             @relation(fields: [petId], references: [id])
  service               SpaService?      @relation(fields: [serviceId], references: [id])
  staff                 User?            @relation("SpaStaffBookings", fields: [staffId], references: [id])
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback              SpaFeedback?

  @@index([categoryId, status])
  @@index([userId])
  @@index([staffId])
  @@map("spa_bookings")
}

model SpaFeedback {
  id           String   @id @default(cuid())
  bookingId    String   @unique @map("booking_id")
  userId       String   @map("user_id")
  rateStaff    Int      @map("rate_staff")
  rateServices Int      @map("rate_services")
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  booking SpaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("spa_feedbacks")
}

model Complaint {
  id           String           @id @default(cuid())
  type         ComplaintType
  status       ComplaintStatus  @default(PENDING)
  title        String
  detail       String?
  reporterId   String?
  targetType   String?
  targetId     String?
  actionTaken  ComplaintAction?
  adminNote    String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([type, status])
  @@index([reporterId])
  @@map("complaints")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model CartItem {
  id        String          @id @default(cuid())
  userId    String
  productId String
  variantId String?         @map("variant_id")
  quantity  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

model AddressSpa {
  id          String         @id
  name        String
  description String?
  address     String
  phone       String?
  status      ApprovalStatus @default(PENDING)
  managerId   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  manager     User?          @relation("SpaAddressManager", fields: [managerId], references: [id])
  bookings    SpaBooking[]   @relation("SpaBookingAddress")
  staffs      SpaStaff[]     @relation("StaffWorkplace")

  @@index([status])
  @@index([managerId])
  @@map("address_spa")
}

model SpaStaff {
  id           String      @id
  userId       String      @unique
  addressSpaId String?
  status       String      @default("ACTIVE")
  addressSpa   AddressSpa? @relation("StaffWorkplace", fields: [addressSpaId], references: [id])
  user         User        @relation("UserSpaStaffProfile", fields: [userId], references: [id], onDelete: Cascade)

  @@map("spa_staff")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model ProductReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("product_reviews")
}

enum Species {
  DOG
  CAT
}

enum Gender {
  MALE
  FEMALE
}

enum PetStatus {
  ACTIVE
  BREAKDOWN
  HIDDEN
  INACTIVE
}

/// Hình thức phối giống:
/// CASH         - Thu tiền mặt (có breedingFee)
/// SHARE_LITTER - Chia con non (chủ cái lấy X con trong lứa)
/// NEGOTIATE    - Thoả thuận sau khi liên hệ
enum BreedingOption {
  CASH
  SHARE_LITTER
  NEGOTIATE
}

/// Trạng thái của một Like (swipe):
/// PENDING  - Đã like, chờ đối phương like lại
/// MATCHED  - Hai bên đã like nhau → tạo Match
/// REJECTED - Đã bỏ qua (swipe trái)
enum LikeStatus {
  PENDING
  MATCHED
  REJECTED
}

/// Trạng thái của một Match:
/// ACTIVE    - Đang hoạt động, hai bên có thể chat
/// COMPLETED - Đã phối giống thành công
/// CANCELLED - Một trong hai huỷ
enum MatchStatus {
  ACTIVE
  MET
  COMPLETED
  CANCELLED
}

enum MatchingRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  PASSED
  CANCELLED
}

/// Vai trò người dùng trên hệ thống
enum UserRole {
  USER
  ADMIN
  MODERATOR
  STORE_MANAGER
  SPA_MANAGER
  SPA_STAFF
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_MANAGER
}

enum OrderStatus {
  PENDING
  PACKED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  PAYMENT_ERROR
}

/// Loại giấy tờ cần duyệt:
/// VACCINE_RECORD - Sổ tiêm phòng / phiếu tiêm vaccine
/// PEDIGREE_CERT  - Giấy chứng nhận phả hệ (VKA / TICA / VNCA)
/// HEALTH_CHECK   - Giấy kiểm tra sức khoẻ tổng quát từ thú y
enum DocumentType {
  VACCINE_RECORD
  PEDIGREE_CERT
  HEALTH_CHECK
}

/// Trạng thái duyệt giấy tờ:
/// PENDING  - Vừa nộp, chờ moderator xem xét
/// REVIEWING - Moderator đang xem xét
/// APPROVED - Đã được duyệt, hợp lệ
/// REJECTED - Bị từ chối, kèm lý do
enum DocumentStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  NEED_MORE_INFO
}

enum ApprovalStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ComplaintType {
  USER
  PET
  MATCHING
  STORE
  SPA
  REVIEW
}

enum ComplaintStatus {
  PENDING
  RESOLVED
  DISMISSED
  ESCALATED
}

enum ComplaintAction {
  DISMISS
  WARNING
  HIDE_CONTENT
  SUSPEND_ACCOUNT
  RESOLVE
  ESCALATE
}

enum SpaBookingStatus {
  PENDING
  CONFIRMED
  CHECK_IN
  ARRIVED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  LATE
}

/// Trạng thái badge xác minh hiển thị trên swipe card:
/// NONE     - Chưa nộp giấy tờ nào (chỉ tự khai báo)
/// PENDING  - Đã nộp giấy tờ, đang chờ moderator duyệt
/// VERIFIED - Ít nhất một giấy tờ được duyệt thành công
enum VerificationBadge {
  NONE
  PENDING
  VERIFIED
}

model Voucher {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String    @default("FREE_SHIP") // FREE_SHIP, PERCENTAGE, FIXED
  value     Float     @default(0) // Số tiền hoặc % giảm (100 đối với 100% ship)
  maxUsage  Int? // Số lần sử dụng tối đa
  usedCount Int       @default(0)
  isActive  Boolean   @default(true)
  expiredAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("vouchers")
}

model ProductUnit {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_units")
}

model ProductVariant {
  id           String      @id @default(cuid())
  productId    String      @map("product_id")
  name         String      // e.g. "Size S", "Màu Đỏ", "500g"
  attributes   Json?       // e.g. { "size": "S", "color": "Đỏ" }
  sellingPrice Float       @map("selling_price")
  salePrice    Float?      @map("sale_price")
  stock        Int         @default(0)
  imageUrl     String?     @map("image_url")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId, isActive])
  @@map("product_variants")
}
